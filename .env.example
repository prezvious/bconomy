# Supabase Configuration for Bconomy
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORT=3000

# Developer commands are off unless this exact switch is enabled.
BCONOMY_DEV_COMMANDS=false
# Optional comma-separated registered/guest UUIDs authorized outside direct local development.
BCONOMY_DEV_USER_IDS=
# Deprecated for one release: use BCONOMY_DEV_COMMANDS instead.
ALLOW_DEV_COMMANDS=false
